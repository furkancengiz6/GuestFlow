{
  "name": "guestflow-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "cross-env ANALYZE=true vite build && node scripts/build-info.js && echo 'Bundle analysis available at dist/stats.html'",
    "build:staging": "cross-env VITE_ENV=staging vite build && node scripts/build-info.js",
    "build:production": "cross-env VITE_ENV=production vite build && node scripts/build-info.js",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "cross-env CI=true jest --ci --coverage --runInBand --maxWarnings=0",
    "test:e2e": "playwright test",
    "test:e2e:staging": "cross-env E2E_REAL_BACKEND=true E2E_USE_WEB_SERVER=false playwright test tests/staging --project=chromium",
    "seed:e2e": "node scripts/create-e2e-storage.cjs",
    "deploy": "bash scripts/deploy.sh",
    "deploy:azure": "bash scripts/deploy-azure.sh",
    "deploy:aws": "bash scripts/deploy-aws.sh",
    "deploy:ftp": "bash scripts/deploy-ftp.sh",
    "docker:build": "docker build -t guestflow-frontend .",
    "docker:run": "docker-compose up -d"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hookform/resolvers": "^5.2.2",
    "@microsoft/signalr": "^10.0.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/lab": "^5.0.0-alpha.157",
    "@mui/material": "^5.15.0",
    "@mui/x-data-grid": "^8.23.0",
    "@mui/x-date-pickers": "^8.21.0",
    "@react-google-maps/api": "^2.20.8",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@tanstack/react-query": "^5.17.0",
    "@tanstack/react-query-devtools": "^5.17.0",
    "axios": "^1.6.2",
    "date-fns": "^4.1.0",
    "i18next": "^25.7.2",
    "notistack": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.2",
    "react-i18next": "^16.5.0",
    "react-router-dom": "6.30.3",
    "react-toastify": "9.1.3",
    "recharts": "^3.5.1",
    "zod": "^4.1.13",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^15.15.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.4.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "terser": "^5.44.1",
    "typescript": "^5.2.2",
    "vite": "^5.4.21",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "esbuild": "0.25.0"
  }
}
