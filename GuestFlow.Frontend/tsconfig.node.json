{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "playwright-global-setup.ts",
    "tests/playwright/**/*.ts",
    "scripts/**/*.ts"
  ]
}

