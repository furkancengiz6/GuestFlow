# =================================================================================
# GuestFlow Frontend Environment Configuration
# =================================================================================
#
# REQUIRED VARIABLES (Must be set in production):
# - VITE_API_BASE_URL (no defaults allowed in production)
#
# PRODUCTION SAFETY:
# - Never use localhost URLs in production builds
# - All required variables must be set (no defaults in production)
# - Copy this file to .env for local development
# - For production deployments, set these as build-time environment variables
# =================================================================================

# ==========================================
# REQUIRED CONFIGURATION
# ==========================================

# API Base URL - REQUIRED (no production defaults)
# Development: http://localhost:5146/api/v1.0
# Production: https://api.yourdomain.com/api/v1.0
VITE_API_BASE_URL=http://127.0.0.1:5146/api/v1.0

# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================

# Environment name
VITE_ENV=development

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

# Application name
VITE_APP_NAME=GuestFlow

# Application version
VITE_APP_VERSION=1.0.0

# ==========================================
# FEATURE FLAGS (Optional)
# ==========================================

# Enable analytics tracking
VITE_ENABLE_ANALYTICS=false

# Enable error tracking/reporting
VITE_ENABLE_ERROR_TRACKING=false

# ==========================================
# BUILD CONFIGURATION (Optional)
# ==========================================

# Build timestamp (set by CI/CD)
VITE_BUILD_DATE=

# ==========================================
# API CONFIGURATION
# ==========================================

# API request timeout in milliseconds
VITE_API_TIMEOUT=30000

# SignalR hub URL (relative to API base URL)
VITE_SIGNALR_URL=/hubs/notifications

# ==========================================
# UPLOAD CONFIGURATION
# ==========================================

# Maximum file size in bytes (10MB default)
VITE_MAX_FILE_SIZE=10485760

# ==========================================
# UI CONFIGURATION
# ==========================================

# Default page size for data tables
VITE_DEFAULT_PAGE_SIZE=10

# Session timeout in milliseconds (30 minutes)
VITE_SESSION_TIMEOUT=1800000

# ==========================================
# DEVELOPMENT ONLY
# ==========================================

# Force development mode (only use in development)
VITE_DEV_MODE=false

# =================================================================================
# PRODUCTION DEPLOYMENT EXAMPLES
# =================================================================================
#
# Docker Environment Variables:
# ENV VITE_API_BASE_URL=http://localhost:5146/api/v1.0https://api.guestflow.com/api/v1.0
# ENV VITE_ENV=production
#
# Kubernetes ConfigMap:
# apiVersion: v1
# kind: ConfigMap
# metadata:
#   name: guestflow-frontend-config
# data:
#   VITE_API_BASE_URL: "https://api.guestflow.com/api/v1.0"
#   VITE_ENV: "production"
#
# Build-time Variables (Vite):
# vite build --mode production
# =================================================================================

