{
  // =================================================================================
  // GuestFlow API - Base Configuration
  // =================================================================================
  //
  // This is the base configuration. Environment-specific overrides:
  // - appsettings.Development.json (for development)
  // - appsettings.Production.json (for production)
  // - Environment variables (highest priority)
  //
  // DEVELOPMENT: Safe defaults with localhost URLs
  // PRODUCTION: Requires explicit configuration (no defaults)
  // =================================================================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*", // Development: allow all hosts for testing
  // ==========================================
  // CORS CONFIGURATION
  // ==========================================
  // SECURITY: Only allow specific, trusted origins
  // Development: localhost URLs with HTTPS enforcement
  // Production: Must be explicitly configured via environment variables
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:5175",
      "http://localhost:3000"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "X-Requested-With"
    ],
    "AllowCredentials": true,
    "MaxAge": 86400
  },
  // ==========================================
  // SECURITY HEADERS (CSP)
  // ==========================================
  // Use SecurityHeaders:ConnectSrc to add extra connect-src entries when needed.
  // Development already allows localhost + ws/wss via code; keep this list for extra hosts/CDNs.
  "SecurityHeaders": {
    "ConnectSrc": [
      "https://api.guestflow.com",
      "wss://api.guestflow.com",
      "https://cdn.jsdelivr.net"
    ]
  },
  // ==========================================
  // DATABASE CONFIGURATION
  // ==========================================
  // Development: Local SQL Express
  // Production: Must be set via environment variables
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=GuestFlowDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  // ==========================================
  // JWT CONFIGURATION
  // ==========================================
  // SECURITY: JWT SecretKey MUST be set via environment variables
  // NEVER commit actual secrets to repository
  "Jwt": {
    "SecretKey": "", // Set via JWT__SecretKey environment variable
    "Issuer": "GuestFlowApp",
    "Audience": "http://localhost:5146", // Development default
    "ExpireMinutes": "45",
    "RefreshTokenExpireDays": "30",
    "MinimumKeyLength": "64" // Minimum 512 bits
  },
  // ==========================================
  // PDF CONFIGURATION
  // ==========================================
  "PdfSettings": {
    "StoragePath": "wwwroot/invoices",
    "BaseUrl": "/invoices", // Development: relative URL
    "OutputPath": "wwwroot/pdfs"
  },
  // ==========================================
  // EMAIL CONFIGURATION
  // ==========================================
  // Development: Disabled by default
  // Production: Configure SMTP settings and set BaseUrl to production API URL
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    "SmtpUsername": "", // Set via environment variables in production
    "SmtpPassword": "", // Set via environment variables in production
    "FromEmail": "noreply@guestflow.com",
    "FromName": "GuestFlow",
    "UseSsl": "true",
    "BaseUrl": "http://localhost:5146", // Development default - production must override
    "Enabled": "false" // Development: disabled
  },
  // ==========================================
  // FILE UPLOAD CONFIGURATION
  // ==========================================
  "FileSettings": {
    "UploadPath": "wwwroot/uploads",
    "MaxFileSize": "10485760",
    "AllowedExtensions": ".jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip",
    "UseAzureBlob": "false", // Set to true in production for cloud storage
    "AzureConnectionString": "", // Required if UseAzureBlob is true
    "AzureContainerName": "guestflow-files",
    "BaseUrl": "http://localhost:5146" // Development default - production must override
  },
  "CurrencySettings": {
    "DefaultCurrency": "TRY"
  },
  // ==========================================
  // ACCOUNTING (GL MAPPING)
  // ==========================================
  "Accounting": {
    "Journal": {
      "ReceivableAccountCode": "1100",
      "DefaultRevenueAccountCode": "4000",
      "AdjustmentAccountCode": "9999",
      "VatPayableAccountCode": "3910",
      "DefaultVatRate": 0.20,
      "VatRateByServiceType": {
        "Transfer": 0.20,
        "CityTour": 0.20,
        "YachtTour": 0.20,
        "Restaurant": 0.10,
        "Package": 0.20
      },
      "RevenueAccountByServiceType": {
        "Transfer": "4000",
        "CityTour": "4010",
        "YachtTour": "4020",
        "Restaurant": "4030",
        "Package": "4040"
      }
    }
  },
  "SmsSettings": {
    "Enabled": "false",
    "Provider": "Mock",
    "ApiKey": "",
    "ApiSecret": "",
    "SenderName": "GuestFlow"
  },
  "LocalizationSettings": {
    "DefaultCulture": "tr-TR",
    "SupportedCultures": [
      "tr-TR",
      "en-US"
    ]
  },
  "AppSettings": {
    "Name": "GuestFlow",
    "Version": "1.0.0",
    "Environment": "Development"
  },
  "RateLimitSettings": {
    "Enabled": true,
    "DefaultRequestsPerMinute": 60,
    "DefaultRequestsPerHour": 1000,
    "DefaultRequestsPerDay": 5000,
    "BlockDurationMinutes": 15,
    "EnableIpBlocking": true,
    "EnableUserBlocking": true,
    "EndpointLimits": {
      "/api/auth/login": {
        "RequestsPerMinute": 5,
        "RequestsPerHour": 20,
        "RequestsPerDay": 50
      },
      "/api/auth/register": {
        "RequestsPerMinute": 3,
        "RequestsPerHour": 10,
        "RequestsPerDay": 25
      },
      "/api/auth/forgot-password": {
        "RequestsPerMinute": 2,
        "RequestsPerHour": 5,
        "RequestsPerDay": 10
      },
      "/api/auth/reset-password": {
        "RequestsPerMinute": 2,
        "RequestsPerHour": 5,
        "RequestsPerDay": 10
      },
      "/api/auth/refresh-token": {
        "RequestsPerMinute": 10,
        "RequestsPerHour": 100,
        "RequestsPerDay": 500
      },
      "/api/auth/revoke-token": {
        "RequestsPerMinute": 10,
        "RequestsPerHour": 50,
        "RequestsPerDay": 200
      },
      "/api/export": {
        "RequestsPerMinute": 10,
        "RequestsPerHour": 50,
        "RequestsPerDay": 200
      },
      "/api/import": {
        "RequestsPerMinute": 5,
        "RequestsPerHour": 20,
        "RequestsPerDay": 100
      },
      "/api/payments": {
        "RequestsPerMinute": 30,
        "RequestsPerHour": 300,
        "RequestsPerDay": 1000
      }
    },
    "WhitelistedPaths": [
      "/swagger",
      "/health",
      "/api/health",
      "/favicon.ico",
      "/robots.txt"
    ],
    "BlockedUserAgents": [
      "sqlmap",
      "nikto",
      "acunetix",
      "nessus",
      "nmap",
      "masscan",
      "zgrab",
      "dirbuster"
    ]
  },
  // ==========================================
  // CACHING CONFIGURATION
  // ==========================================
  "CacheSettings": {
    "Enabled": true,
    "DefaultCacheDurationMinutes": 60,
    "CacheDurations": {
      "airports": 120,
      "cities": 120,
      "vehicles": 120,
      "settings": 30
    }
  },
  // ==========================================
  // DEMO DATA SEEDING (SECURITY)
  // ==========================================
  // IMPORTANT: Only enable in development with SeedDemoData=true
  // NEVER enable in production environments
  "SeedDemoData": "false",
  // ==========================================
  // NEO4J GRAPH DATABASE CONFIGURATION
  // ==========================================
  // Development: Local Neo4j instance
  // Production: Must be set via environment variables
  "Neo4j": {
    "Uri": "bolt://localhost:7687",
    "Username": "neo4j",
    "Password": "", // Set via NEO4J__Password environment variable
    "Database": "neo4j",
    "ConnectionTimeoutSeconds": 30,
    "MaxConnectionPoolSize": 50,
    "Enabled": false // Set to true to enable graph intelligence features
  },
  "OTA": {
    "BookingDotCom": {
      "Username": "machine_user",
      "Password": "",
      "WebhookSecret": "" // Set via OTA__BookingDotCom__WebhookSecret
    },
    "Expedia": {
      "ApiKey": "",
      "ApiSecret": "",
      "WebhookSecret": "" // Set via OTA__Expedia__WebhookSecret
    }
  },
  "PMS": {
    "Opera": {
      "ApiEndpoint": "https://api.opera-cloud.com",
      "ApiKey": "", // Client ID
      "ApiSecret": "", // Client Secret
      "OcpApimSubscriptionKey": "", // Integraion Key
      "HotelId": ""
    },
    "Elektraweb": {
      "ApiEndpoint": "https://api.elektraweb.com",
      "ApiKey": "", // Tenant Token
      "HotelId": ""
    },
    "Stripe": {
      "SecretKey": "",
      "PublishableKey": "",
      "WebhookSecret": ""
    }
  }
}