# GuestFlow API - Production Environment Variables
# Copy this file to .env and configure for your production environment

# ==========================================
# DATABASE CONFIGURATION (REQUIRED)
# ==========================================
# SQL Server connection string for production database
ConnectionStrings__DefaultConnection="Server=your-prod-db-server;Database=GuestFlowDb;User Id=your-db-user;Password=your-secure-password;TrustServerCertificate=false;"

# ==========================================
# JWT CONFIGURATION (REQUIRED)
# ==========================================
# Generate a secure 256-bit key: openssl rand -base64 32
Jwt__SecretKey="your-256-bit-base64-encoded-secret-key-here"
Jwt__Audience="https://api.yourdomain.com"

# ==========================================
# CORS CONFIGURATION (REQUIRED)
# ==========================================
# Comma-separated list of allowed origins
Cors__AllowedOrigins="https://app.yourdomain.com,https://admin.yourdomain.com"

# ==========================================
# EMAIL CONFIGURATION (OPTIONAL but recommended)
# ==========================================
EmailSettings__SmtpHost="smtp.your-provider.com"
EmailSettings__SmtpPort="587"
EmailSettings__SmtpUsername="noreply@yourdomain.com"
EmailSettings__SmtpPassword="your-smtp-password"
EmailSettings__FromEmail="noreply@yourdomain.com"
EmailSettings__BaseUrl="https://api.yourdomain.com"

# ==========================================
# PDF CONFIGURATION (OPTIONAL)
# ==========================================
PdfSettings__BaseUrl="https://api.yourdomain.com"

# ==========================================
# FILE UPLOAD CONFIGURATION (OPTIONAL)
# ==========================================
FileSettings__BaseUrl="https://api.yourdomain.com"

# For Azure Blob Storage (optional):
# FileSettings__UseAzureBlob="true"
# FileSettings__AzureConnectionString="your-azure-connection-string"
# FileSettings__AzureContainerName="guestflow-files"

# ==========================================
# MONITORING (OPTIONAL)
# ==========================================
# Seq logging server URL
# Serilog__WriteTo__1__Args__serverUrl="https://seq.yourdomain.com"

# ==========================================
# ASP.NET CORE SETTINGS
# ==========================================
ASPNETCORE_ENVIRONMENT="Production"
ASPNETCORE_URLS="http://*:5000;https://*:5001"