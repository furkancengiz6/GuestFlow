# Staging Environment Configuration
# Copy this file to .env for staging deployment

# Application
VITE_APP_NAME=GuestFlow Staging
VITE_APP_VERSION=1.0.0-staging
VITE_ENV=staging

# API Configuration
VITE_API_BASE_URL=https://guestflow-api-staging.azurewebsites.net/api/v1.0

# Feature Flags
VITE_ENABLE_DEBUG=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=true

# External Services
VITE_GOOGLE_MAPS_API_KEY=your-staging-google-maps-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-staging-stripe-key

# Logging
VITE_LOG_LEVEL=debug
