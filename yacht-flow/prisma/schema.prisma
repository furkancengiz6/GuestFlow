generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("GUEST") // GUEST, HOST, ADMIN
  password      String?   // For Credentials provider
  companyName   String?   // For Yacht Companies
  phoneNumber   String?   
  isApproved    Boolean   @default(false) // Approval for Hosts
  
  accounts      Account[]
  sessions      Session[]
  yachts        Yacht[]
  bookings      Booking[]
  reviews       Review[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Yacht {
  id          String   @id @default(cuid())
  name        String
  type        String   // Motor Yacht, Luxury Gulet, Catamaran
  location    String
  length      String
  guests      Int
  cabins      Int
  crew        Int
  pricePerDay Float
  description String
  imageUrl    String
  amenities   Amenity[]

  hostId String
  host   User   @relation(fields: [hostId], references: [id])

  bookings Booking[]
  reviews  Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  comment   String   @db.Text
  images    String?  // JSON array of image URLs
  createdAt DateTime @default(now())

  yacht     Yacht    @relation(fields: [yachtId], references: [id])
  yachtId   String
  
  user      User     @relation(fields: [userId], references: [id])
  userId    String
}

model Booking {
  id         String   @id @default(cuid())
  startDate  DateTime
  endDate    DateTime
  totalPrice Float
  status     String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  guestCount Int      @default(2)
  
  services   String?  // JSON string for selected onboard services
  specialNotes String?

  guestId String
  guest   User   @relation(fields: [guestId], references: [id])

  yachtId String
  yacht   Yacht  @relation(fields: [yachtId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Amenity {
  id      String  @id @default(cuid())
  name    String  @unique
  icon    String? // Optional icon name
  yachts  Yacht[]
}
