# Production Environment Configuration
# Copy this file to .env for production deployment

# Application
VITE_APP_NAME=GuestFlow
VITE_APP_VERSION=1.0.0
VITE_ENV=production

# API Configuration
VITE_API_BASE_URL=https://guestflow-api.azurewebsites.net/api/v1.0

# Feature Flags
VITE_ENABLE_DEBUG=false
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true

# External Services
VITE_GOOGLE_MAPS_API_KEY=your-production-google-maps-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your-production-stripe-key

# Logging
VITE_LOG_LEVEL=warn
